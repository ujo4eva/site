---
import { getSections } from '../lib/sections';
import Eq from './Eq.astro';

const pathname = Astro.url.pathname;
const sections = await getSections();
---

<header class="flex items-baseline justify-between gap-6 py-10">
  <a href="/" class="inline-flex items-baseline gap-2 font-medium text-zinc-100">
    <Eq class="paused text-accent" />
    ujo4eva
  </a>

  <nav class="flex flex-wrap justify-end gap-x-4 gap-y-1 font-mono text-sm">
    {
      sections.map((section) => {
        const active = pathname.startsWith(section.href);
        return (
          <a
            href={section.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'transition-colors',
              active ? 'text-zinc-100' : 'text-zinc-500 hover:text-zinc-100',
            ]}
          >
            {section.label}
          </a>
        );
      })
    }
  </nav>
</header>
