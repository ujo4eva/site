---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const projects = await getCollection('projects');
const sorted = projects.sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Projects — ujo4eva" description="Open-source projects from Osadebamwen Uwadiae.">
  <PageHeader title="projects" blurb="things i've built." />

  {sorted.length === 0 && <p class="text-zinc-500">No projects yet. Check back soon.</p>}

  <ol class="border-t border-zinc-900">
    {
      sorted.map((project, i) => (
        <li class="border-b border-zinc-900">
          <a
            href={project.data.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 py-4"
          >
            <span class="font-mono text-sm text-zinc-600 transition-colors group-hover:text-accent">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="min-w-0">
              <span class="font-medium text-zinc-100">{project.data.title}</span>
              {project.data.featured && <span class="ml-2 font-mono text-xs text-accent">featured</span>}
              <span class="mt-1 block text-sm leading-relaxed text-zinc-500">{project.data.description}</span>
              {project.data.tags.length > 0 && (
                <span class="mt-2 block font-mono text-xs text-zinc-600">
                  {project.data.tags.map((tag) => tag.toLowerCase()).join(' · ')}
                </span>
              )}
            </span>
            <span class="font-mono text-sm text-zinc-600 transition-colors group-hover:text-zinc-100" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</Layout>
