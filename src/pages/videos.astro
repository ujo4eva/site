---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const videos = await getCollection('videos', ({ data }) => !data.draft);

function getYouTubeId(url: string): string | null {
  const match = url.match(
    /(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]{11})/,
  );
  return match ? match[1] : null;
}

const sorted = videos.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Videos — ujo4eva" description="Videos edited and graded by Osadebamwen Uwadiae.">
  <PageHeader title="videos" blurb="stuff i've cut and graded." />

  {sorted.length === 0 && <p class="text-zinc-500">No videos yet. Check back soon.</p>}

  <ol class="grid gap-12">
    {
      sorted.map((video) => {
        const id = getYouTubeId(video.data.videoUrl);
        const thumb = id ? `https://img.youtube.com/vi/${id}/hqdefault.jpg` : null;
        return (
          <li>
            <a href={video.data.videoUrl} target="_blank" rel="noopener noreferrer" class="group block">
              {thumb && (
                <div class="mb-3 aspect-video overflow-hidden bg-zinc-900">
                  <img
                    src={thumb}
                    alt={video.data.title}
                    class="h-full w-full object-cover opacity-80 transition-opacity group-hover:opacity-100"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="font-medium text-zinc-100">{video.data.title}</h2>
                <span class="shrink-0 font-mono text-xs text-zinc-600">{video.data.role}</span>
              </div>
              {video.data.description && (
                <p class="mt-1 text-sm leading-relaxed text-zinc-500">{video.data.description}</p>
              )}
            </a>
          </li>
        );
      })
    }
  </ol>
</Layout>
