---
import Layout from '../layouts/Layout.astro';
import Eq from '../components/Eq.astro';
import Socials from '../components/Socials.astro';
import { getSections } from '../lib/sections';

const sections = await getSections();
---

<Layout
  title="ujo4eva"
  chrome={false}
>
  <div class="flex min-h-dvh flex-col justify-center py-24">
    <p class="mb-16 inline-flex items-baseline gap-2 font-mono text-sm text-zinc-500">
      <Eq class="text-accent" />
      ujo4eva
    </p>

    <h1 class="text-4xl font-semibold tracking-tight text-zinc-100 sm:text-5xl">
      Osadebamwen Uwadiae
    </h1>
    <p class="mt-3 text-lg text-zinc-400">
      mixes music, cuts video, builds things. sometimes.
    </p>

    {
      sections.length > 0 && (
        <ol class="mt-16 border-t border-zinc-900">
          {sections.map((section, i) => (
            <li class="border-b border-zinc-900">
              <a
                href={section.href}
                class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 py-4 sm:grid-cols-[2.5rem_7rem_1fr_auto]"
              >
                <span class="font-mono text-sm text-zinc-600 transition-colors group-hover:text-accent">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-medium text-zinc-100">{section.label}</span>
                <span class="hidden text-zinc-500 sm:block">{section.blurb}</span>
                <span class="font-mono text-sm text-zinc-600 transition-colors group-hover:text-zinc-100">
                  {section.count}
                  <span class="ml-1 inline-block transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }

    <div class="mt-16">
      <Socials />
    </div>
  </div>
</Layout>
