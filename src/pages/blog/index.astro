---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = posts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Writing — ujo4eva" description="Blog posts from Osadebamwen Uwadiae — audio engineering, tech, fitness, and culture.">
  <PageHeader title="writing" blurb="notes, occasionally." />

  {sorted.length === 0 && <p class="text-zinc-500">No posts yet. Check back soon.</p>}

  <ol class="border-t border-zinc-900">
    {
      sorted.map((post) => (
        <li class="border-b border-zinc-900">
          <a
            href={`/blog/${post.id}`}
            class="group grid grid-cols-[6.5rem_1fr] items-baseline gap-x-4 py-4"
          >
            <time
              datetime={post.data.date.toISOString()}
              class="font-mono text-sm text-zinc-600 tabular-nums transition-colors group-hover:text-accent"
            >
              {post.data.date.toISOString().slice(0, 10)}
            </time>
            <span>
              <span class="font-medium text-zinc-100">{post.data.title}</span>
              <span class="mt-1 block text-sm text-zinc-500">{post.data.description}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</Layout>
