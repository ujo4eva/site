// Cloudflare Worker that serves the static Astro build from ./dist.
// No Worker script: requests are answered straight from the assets.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Astro builds pages as /mixes/index.html, served at /mixes/.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // Wrangler creates the DNS record and certificate for this on deploy.
  "routes": [{ "pattern": "ujo4eva.fyi", "custom_domain": true }],
  // The site lives on the custom domain only.
  "workers_dev": false,
  "preview_urls": false
}
